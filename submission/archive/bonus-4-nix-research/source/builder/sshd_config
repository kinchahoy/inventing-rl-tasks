Port 22
HostKey /etc/ssh/replica_host_key
PidFile /run/sshd/replica.pid
AuthorizedKeysFile .ssh/authorized_keys
AllowUsers buildclient
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
PermitUserEnvironment no
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
PermitTTY no
StrictModes yes
ForceCommand /opt/nix-current/bin/nix-daemon --stdio
