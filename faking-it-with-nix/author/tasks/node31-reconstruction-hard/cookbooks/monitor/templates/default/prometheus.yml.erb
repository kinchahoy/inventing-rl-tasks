global:
  scrape_interval: 5s
  evaluation_interval: 5s
  external_labels:
    site: node31
rule_files:
  - /etc/prometheus/rules/rules_*.yml
  - /etc/prometheus/rules/alerts_*.yml
alerting:
  alert_relabel_configs:
    - regex: replica
      action: labeldrop
    - target_label: source
      replacement: prometheus
  alertmanagers:
    - static_configs:
        - targets: ['127.0.0.1:9093']
scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['127.0.0.1:9090']
    relabel_configs:
      - target_label: instance
        replacement: node31:9090
  - job_name: alertmanager
    static_configs:
      - targets: ['127.0.0.1:9093']
    relabel_configs:
      - target_label: instance
        replacement: node31:9093
  - job_name: blackbox_exporter
    static_configs:
      - targets: ['127.0.0.1:9115']
    relabel_configs:
      - target_label: instance
        replacement: node31:9115
  - job_name: node
    file_sd_configs:
      - files: ['/etc/prometheus/targets/node_*.yml']
    relabel_configs:
      - source_labels: [__address__]
        regex: '([^:]+):\d+'
        target_label: hostname
        replacement: '$1'
<% if @drop_decommissioned -%>
      - source_labels: [decommissioned]
        regex: 'true'
        action: drop
<% end -%>
<% jobs = { 'probe_http' => 'http_2xx', 'probe_auth' => 'http_auth_required', 'probe_tcp' => 'tcp_connect' }
   jobs['probe_icmp'] = 'icmp' if @icmp_probe
   jobs.each do |job, mod| -%>
  - job_name: <%= job %>
    metrics_path: /probe
    params:
      module: [<%= mod %>]
    file_sd_configs:
      - files: ['/etc/prometheus/targets/<%= job %>_*.yml']
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9115
<% end -%>
